{
  "name": "conference-app-template",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "sync-data": "bun ./scripts/syncData.ts",
    "use-example": "bun ./scripts/useExample.ts",
    "generate-brand-assets": "node ./scripts/generateBrandAssets.mjs",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/ui": "~58.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@legendapp/list": "^2.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/react-native-skia": "2.13.1",
    "@zoontek/react-native-navigation-bar": "^1.0.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "expo": "^58.0.9",
    "expo-application": "~58.1.1",
    "expo-asset": "~58.0.14",
    "expo-blur": "~58.0.3",
    "expo-build-properties": "~58.0.10",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.11",
    "expo-dev-client": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.3",
    "expo-haptics": "~58.0.6",
    "expo-image": "~58.0.14",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.12",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.3",
    "expo-router": "~58.0.18",
    "expo-splash-screen": "~58.0.8",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "expo-updates": "~58.0.16",
    "expo-web-browser": "~58.0.6",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.9",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.29.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.2.5",
    "sucrase": "^3.35.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  }
}
